{
  "manifest_version": 3,
  "name": "StudieSync",
  "description": "Synkroniser dit Studie+ skema med Google Kalender.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://all.uddataplus.dk/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "StudieSync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://all.uddataplus.dk/*"
      ],
      "js": [
        "gwt.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "INSERT CLIENT ID HERE",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  }
}
